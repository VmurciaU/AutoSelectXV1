# ============================================================
#   AUTOSELECT-X / AI EngiQuote
#   .gitignore limpio, profesional y seguro
# ============================================================

# ---- ENTORNOS VIRTUALES ----
venv/

# ---- ARCHIVOS DEL SISTEMA ----
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.DS_Store

# ---- ARCHIVOS SENSIBLES / SECRETS ----
.env
env.sh
start_server.sh
raggrafo/pipelines/key.txt

# ---- LOGS, BASES DE DATOS LOCALES ----
*.log
*.sqlite

# ---- JUPYTER ----
.ipynb_checkpoints/

# ---- EDITORES ----
.vscode/

# ---- BUILD / DISTRIBUCIÓN ----
build/
dist/
*.egg-info/

# ---- PDF DOCUMENTS (no se suben al repo) ----
*.pdf

# ---- DOCKER COMPOSE LOCAL DE WSL ----
compose/

# ---- DATA & SHARED (datos temporales / sensibles) ----
shared_data/
data/

# ---- RAG STORAGE (generado automáticamente) ----
raggrafo/rag_storage/
raggrafo/tests/
raggrafo/outputs/

# ---- BENCHMARKS, RESULTADOS TEMPORALES ----
benchmark_v*.json
benchmark_v*.md
raw.json

# ---- ARCHIVOS GENERADOS POR EL PIPELINE ----
RAGGrafo_borrar/
outputs/
outputs/*.json
outputs/session_files/

requirements_full_backup.txt
